{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#36463e",
      "titleColor": "#36463e",
      "gridColor": "#e8ede7"
    }
  },
  "height": 350,
  "data": {
    "url": "data/processed/park_parcels_sample.csv"
  },
  "mark": {
    "type": "boxplot",
    "extent": 1.5,
    "size": 36
  },
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "axis": {
        "title": null,
        "labelAngle": -20
      }
    },
    "y": {
      "field": "ha",
      "type": "quantitative",
      "scale": {
        "type": "log"
      },
      "title": "Individual record area (ha), log scale"
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "legend": null,
      "scale": {
        "scheme": "tableau20"
      }
    },
    "tooltip": [
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "ha",
        "type": "quantitative",
        "title": "Area (ha)",
        "format": ",.1f"
      }
    ]
  }
}