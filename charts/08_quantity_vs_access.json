{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#36463e",
      "titleColor": "#36463e",
      "gridColor": "#e8ede7"
    }
  },
  "height": 390,
  "data": {
    "url": "data/processed/melbourne_lga_summary_final.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#b7bbb4"
      },
      "encoding": {
        "x": {
          "aggregate": "mean",
          "field": "everyday_parkland_pct",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#b7bbb4"
      },
      "encoding": {
        "y": {
          "aggregate": "mean",
          "field": "walkable_land_pct",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 0.78
      },
      "encoding": {
        "x": {
          "field": "everyday_parkland_pct",
          "type": "quantitative",
          "title": "Everyday parkland (% of land)"
        },
        "y": {
          "field": "walkable_land_pct",
          "type": "quantitative",
          "title": "400m catchment land coverage (%)"
        },
        "color": {
          "value": "#31744e"
        },
        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "everyday_parkland_pct",
            "type": "quantitative",
            "title": "Parkland (%)",
            "format": ",.1f"
          },
          {
            "field": "walkable_land_pct",
            "type": "quantitative",
            "title": "Catchment (%)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.lga_name === 'Whitehorse' || datum.lga_name === 'Yarra Ranges'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 155,
        "color": "#1d4536",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "everyday_parkland_pct",
          "type": "quantitative"
        },
        "y": {
          "field": "walkable_land_pct",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "everyday_parkland_pct",
            "type": "quantitative",
            "title": "Parkland (%)",
            "format": ".1f"
          },
          {
            "field": "walkable_land_pct",
            "type": "quantitative",
            "title": "400m coverage (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.lga_name === \"Whitehorse\""
        },
        {
          "calculate": "datum.lga_name + '\\n' + format(datum.everyday_parkland_pct, '.1f') + '% parkland · ' + format(datum.walkable_land_pct, '.1f') + '% coverage'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 11,
        "dy": 18,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#000000",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "lineBreak": "\n",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "everyday_parkland_pct",
          "type": "quantitative"
        },
        "y": {
          "field": "walkable_land_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.lga_name === \"Yarra Ranges\""
        },
        {
          "calculate": "datum.lga_name + '\\n' + format(datum.everyday_parkland_pct, '.1f') + '% parkland · ' + format(datum.walkable_land_pct, '.1f') + '% coverage'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "dy": -20,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#000000",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "lineBreak": "\n",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "everyday_parkland_pct",
          "type": "quantitative"
        },
        "y": {
          "field": "walkable_land_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    }
  ]
}
