{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#394a42",
      "titleColor": "#394a42",
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelColor": "#394a42",
      "titleColor": "#394a42"
    }
  },
  "height": 295,
  "data": {
    "url": "data/processed/parkland_density_dotstrip.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          3,
          4
        ],
        "color": "#b8c7bb"
      },
      "encoding": {
        "x": {
          "aggregate": "median",
          "field": "everyday_ha_per_1000",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 135,
        "opacity": 0.87,
        "stroke": "white",
        "strokeWidth": 0.7
      },
      "encoding": {
        "x": {
          "field": "everyday_ha_per_1000",
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "axis": {
            "title": "Everyday parkland (ha per 1,000 residents)",
            "grid": true,
            "gridColor": "#edf0ea"
          }
        },
        "y": {
          "field": "y_position",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.45,
              2.45
            ]
          },
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2
            ],
            "labelExpr": "datum.value === 0 ? 'Low density' : datum.value === 1 ? 'Medium density' : 'High density'",
            "grid": false
          }
        },
        "color": {
          "field": "density_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Low density",
              "Medium density",
              "High density"
            ],
            "range": [
              "#8abf83",
              "#479b88",
              "#2d5f65"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "Municipality"
          },
          {
            "field": "density_group",
            "type": "nominal",
            "title": "Density group"
          },
          {
            "field": "population_density_km2",
            "type": "quantitative",
            "title": "Residents/km²",
            "format": ",.0f"
          },
          {
            "field": "everyday_ha_per_1000",
            "type": "quantitative",
            "title": "Parkland ha/1,000",
            "format": ".2f"
          }
        ]
      }
    }
  ]
}
