{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelColor": "#394a42",
      "titleColor": "#394a42",
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelColor": "#394a42",
      "titleColor": "#394a42"
    }
  },
  "height": 360,
  "data": {
    "url": "data/processed/park_area_cumulative.csv"
  },
  "mark": {
    "type": "line",
    "interpolate": "step-after",
    "strokeWidth": 2.8,
    "clip": true
  },
  "encoding": {
    "x": {
      "field": "ha_threshold",
      "type": "quantitative",
      "scale": {
        "type": "log"
      },
      "axis": {
        "title": "Parcel area threshold (ha, logarithmic scale)",
        "grid": false,
        "values": [
          0.01,
          0.1,
          1,
          10,
          100,
          1000,
          10000
        ],
        "format": "~g"
      }
    },
    "y": {
      "field": "cumulative_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "title": "Share of parcels at or below threshold (%)",
        "values": [
          0,
          25,
          50,
          75,
          100
        ],
        "grid": true,
        "gridColor": "#edf0ea"
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Parks and gardens",
          "Natural and semi-natural open space",
          "Recreation corridor",
          "Sportsfields and organised recreation"
        ],
        "range": [
          "#2b855b",
          "#8abf83",
          "#d3a653",
          "#4b96b6"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 2,
        "labelLimit": 300,
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "ha_threshold",
        "type": "quantitative",
        "title": "Area threshold (ha)",
        "format": ",.2f"
      },
      {
        "field": "cumulative_pct",
        "type": "quantitative",
        "title": "Parcels at or below",
        "format": ".1f"
      },
      {
        "field": "n_parcels",
        "type": "quantitative",
        "title": "Total parcels",
        "format": ",d"
      }
    ]
  }
}
